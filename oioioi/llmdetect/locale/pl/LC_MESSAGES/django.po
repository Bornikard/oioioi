msgstr "%(similarity)s kodu pokrywa się z referencją LLM (u uczestników zwykle: %(baseline)s)."

#, python-format
msgid "Far from own style (z = %(z)s) and closer to LLM style (%(style)s, usually %(profile)s)."
msgstr "Daleko od własnego stylu (z = %(z)s) i bliżej stylu LLM (%(style)s, zwykle %(profile)s)."

#, python-format
msgid "Far from own style (z = %(z)s), profile confidence %(confidence)s."
msgstr "Daleko od własnego stylu (z = %(z)s), pewność profilu %(confidence)s."

#, python-format
msgid "Solved after %(minutes).0f min; others needed %(median).0f min (median)."
msgstr "Rozwiązane po %(minutes).0f min; inni potrzebowali %(median).0f min (mediana)."

